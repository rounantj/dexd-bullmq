generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["filteredRelationCount"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                             Int                           @id @default(autoincrement())
  email                          String                        @unique
  name                           String
  surname                        String?
  password                       String
  confirmationCode               String?
  identification                 String                        @unique
  description                    String?                       @db.LongText
  cellphone                      String
  phone                          String?
  profilePicture                 String?                       @db.Text
  socialMedia                    Json?
  birthDate                      DateTime?
  addressId                      Int
  languageId                     Int?
  roleId                         Int
  subtype                        String?                       // Subtype for role 'usuário': 'content_creator', 'store', 'service_provider'
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  deletedAt                      DateTime?
  walletId                       String?
  customerId                     String?
  indicationCode                 String?                       @db.VarChar(36)
  referralCode                   String?                       @default(uuid())
  professionalIdentification     String?                       @unique
  professionalIdentificationType String?
  requestDelete                  Boolean                       @default(false)
  isCellphoneValidated           Boolean?                      @default(false)
  deleteReason                   String?
  outsideRegistered              Boolean                       @default(false)
  totalDexdPoints                Int?                          @default(0)
  /// Data da primeira assinatura paga
  firstPaidSubscriptionAt        DateTime?
  /// Indica se o perfil está 100% completo
  isProfileComplete              Boolean                       @default(false)
  isChatAvailable                Boolean                       @default(true)
  shortName                      String?                       @unique
  architect                      Architect?
  bankCards                      BankCard[]
  billing_notifications          billing_notifications[]
  opportunities                  BusinessOpportunity[]
  opportunityResponses           BusinessOpportunityResponse[]
  cart                           Cart?
  complaints                     Complaint[]
  conversationsParticipantOne    Conversation[]                @relation("participantOne")
  conversationsParticipantTwo    Conversation[]                @relation("participantTwo")
  dexdBoosts                     DexdBoost[]
  coursesSkills                  DexdCourseSkill[]
  dexdPoints                     DexdPoint[]
  dexdTvVideos                   DexdTvVideo[]
  dexdTvVideoLikes               DexdTvVideoLikes[]
  tags                           Entity_Tag[]                  @relation("UserTags")
  Environment_Likes              Environment_Likes[]
  environmentViews               EnvironmentViews[]            @relation("viewer")
  ExchangedBenefit               ExchangedBenefit[]
  followed                       Follower[]                    @relation("followed")
  follower                       Follower[]                    @relation("follower")
  formationsSkills               FormationSkill[]
  invoices                       Invoice[]
  jobExperiencesSkills           JobExperienceSkill[]
  languagesSkills                LanguageSkill[]
  suggestedByUsers               Notification[]                @relation("suggestedBy")
  notifications                  Notification[]                @relation("notificated")
  orders                         Order[]
  payment_methods                payment_methods[]
  postViews                      PostViews[]
  posts                          Post[]
  postLikes                      PostLikes[]
  productsViewed                 ProductViews[]
  ProductLikes                   ProductLikes[]
  store                          Store?
  subscription_history           subscription_history[]
  usage_tracking                 usage_tracking[]
  dexdTvCourses                  UserDexdTvVideo[]
  userSubscription               UserSubscription?
  address                        Address                       @relation(fields: [addressId], references: [id], onDelete: Cascade)
  language                       Language?                     @relation(fields: [languageId], references: [id])
  role                           Role                          @relation(fields: [roleId], references: [id], onDelete: NoAction)
  viewProfile                    UserViews[]                   @relation("profile")
  views                          UserViews[]                   @relation("viewer")
  galleries                      Gallery[]                     // Galerias criadas pelo usuário
  galleryPins                    GalleryPin[]                  // Marcações criadas pelo usuário
  galleryLikes                   GalleryLikes[]                // Curtidas em galerias

  @@index([addressId], map: "users_addressId_fkey")
  @@index([languageId], map: "users_languageId_fkey")
  @@index([roleId], map: "users_roleId_fkey")
  @@index([subtype], map: "idx_users_subtype")
  @@map("users")
}

model UserViews {
  id        Int      @id @default(autoincrement())
  viewerId  Int?
  profileId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   User?    @relation("profile", fields: [profileId], references: [id], map: "profile_user")
  viewer    User?    @relation("viewer", fields: [viewerId], references: [id], map: "viewer_user")

  @@unique([viewerId, profileId])
  @@index([profileId], map: "profile_user")
  @@map("users_views")
}

model Conversation {
  id                       Int       @id @default(autoincrement())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  participantOneId         Int
  participantTwoId         Int
  participantOneReadStatus Boolean   @default(false)
  participantTwoReadStatus Boolean   @default(false)
  lastMessageAt            DateTime? @default(now())
  participantOne           User      @relation("participantOne", fields: [participantOneId], references: [id], onDelete: NoAction, map: "conversation_from_user_fkey")
  participantTwo           User      @relation("participantTwo", fields: [participantTwoId], references: [id], onDelete: NoAction, map: "conversation_to_user_fkey")
  messages                 Message[]

  @@index([participantOneId], map: "conversation_from_user_fkey")
  @@index([participantTwoId], map: "conversation_to_user_fkey")
  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String       @db.LongText
  userId         Int
  conversationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: NoAction)

  @@index([conversationId], map: "messages_conversationId_fkey")
  @@map("messages")
}

model Environment_Likes {
  like          Boolean     @default(true)
  userId        Int
  environmentId Int
  createdAt     DateTime?   @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: NoAction)
  user          User        @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@id([userId, environmentId])
  @@index([userId, environmentId])
  @@index([environmentId], map: "enviroments_likes_environmentId_fkey")
  @@map("enviroments_likes")
}

model Environment {
  id                 Int                               @id @default(autoincrement())
  name               String
  description        String                            @db.LongText
  architectId        Int?                              // Torna opcional para usuários comuns
  userId             Int?                              // Novo campo para usuários comuns
  type               String                            @default("environment") // "environment" ou "gallery"
  pricePerTag        Int?                              // Preço por marcação em DexdPoints
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @default(now())
  feedDescription    String?                           @db.VarChar(250)
  toFeed             Boolean                           @default(true)
  relevance          Int                               @default(0)
  visualizations     Int                               @default(0)
  complaints         Complaint[]
  dexdBoosts         DexdBoost[]
  tags               Entity_Tag[]
  likes              Environment_Likes[]
  environmentProfile EnvironmentViews[]                @relation("environment")
  architect          Architect?                        @relation(fields: [architectId], references: [id], onDelete: NoAction)
  // user               User?                             @relation(fields: [userId], references: [id], onDelete: NoAction)
  serviceProviders   EnvironmentServiceProviderStore[]
  medias             Media[]

  @@index([architectId], map: "environments_architectId_fkey")
  @@index([userId], map: "environments_userId_fkey")
  @@map("environments")
}

model Gallery {
  id                 Int                               @id @default(autoincrement())
  name               String
  description        String                            @db.LongText
  userId             Int                               // Usuário que criou a galeria
  pricePerTag        Int?                              // Preço por marcação em DexdPoints
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @default(now())
  feedDescription    String?                           @db.VarChar(250)
  toFeed             Boolean                           @default(true)
  relevance          Int                               @default(0)
  visualizations     Int                               @default(0)
  likes              Int                               @default(0)
  user               User                              @relation(fields: [userId], references: [id], onDelete: NoAction)
  galleryMedias      GalleryMedia[]
  galleryLikes       GalleryLikes[]
  tags               Entity_Tag[]                      // Tags da galeria

  @@index([userId], map: "galleries_userId_fkey")
  @@map("galleries")
}

model GalleryLikes {
  like      Boolean @default(true)
  userId    Int
  galleryId Int
  createdAt DateTime @default(now())
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: NoAction)
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@id([userId, galleryId])
  @@index([userId, galleryId])
  @@index([galleryId], map: "gallery_likes_galleryId_fkey")
  @@map("gallery_likes")
}

model GalleryMedia {
  id            Int         @id @default(autoincrement())
  url           String      @db.LongText
  galleryId     Int
  gallery       Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  galleryPins   GalleryPin[]

  @@index([galleryId], map: "gallery_medias_galleryId_fkey")
  @@map("gallery_medias")
}

model GalleryPin {
  id            Int            @id @default(autoincrement())
  xAxis         String
  yAxis         String
  productId     Int?
  mediaId       Int
  userId        Int            // Usuário que criou a marcação
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  type          String
  url           String?        @db.LongText
  paid          Boolean        @default(false) // Se a marcação foi paga
  paidAmount    Int?           // Valor pago em DexdPoints
  user          User           @relation(fields: [userId], references: [id], onDelete: NoAction)
  media         GalleryMedia   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([userId], map: "gallery_pins_userId_fkey")
  @@index([mediaId], map: "gallery_pins_mediaId_fkey")
  @@index([productId], map: "gallery_pins_productId_fkey")
  @@map("gallery_pins")
}

model EnvironmentViews {
  id            Int          @id @default(autoincrement())
  viewerId      Int?
  environmentId Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  environment   Environment? @relation("environment", fields: [environmentId], references: [id], map: "profile_environment")
  viewer        User?        @relation("viewer", fields: [viewerId], references: [id], map: "viewer_environment")

  @@unique([viewerId, environmentId])
  @@index([environmentId], map: "profile_environment")
  @@map("environment_views")
}

model Media {
  id            Int         @id @default(autoincrement())
  url           String      @db.LongText
  environmentId Int
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  pins          Pin[]

  @@index([environmentId], map: "medias_environmentId_fkey")
  @@map("medias")
}

model Pin {
  id            Int            @id @default(autoincrement())
  xAxis         String
  yAxis         String
  productId     Int?
  mediaId       Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  architectId   Int?           // Torna opcional para usuários comuns
  userId        Int?           // Novo campo para usuários comuns
  type          String
  url           String?        @db.LongText
  paid          Boolean        @default(false) // Se a marcação foi paga
  paidAmount    Int?           // Valor pago em DexdPoints
  productsOrder OrderProduct[]
  architect     Architect?     @relation(fields: [architectId], references: [id], onDelete: NoAction)
  // user          User?          @relation(fields: [userId], references: [id], onDelete: NoAction)
  media         Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productsCart  ProductCart[]

  @@index([architectId], map: "pins_architectId_fkey")
  @@index([userId], map: "pins_userId_fkey")
  @@index([mediaId], map: "pins_mediaId_fkey")
  @@index([productId], map: "pins_productId_fkey")
  @@map("pins")
}

model Architect {
  id                     Int           @id @default(autoincrement())
  occupation             String?
  educationalInstitution String?
  formationYear          Int?
  userId                 Int           @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  companyName            String?
  tradingName            String?
  visualizations         Int           @default(0)
  pis                    String?
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dexdBoosts             DexdBoost[]
  projects               Environment[]
  pin                    Pin[]

  @@map("architects")
}

model Store {
  id                 Int                               @id @default(autoincrement())
  stateRegistration  String?
  serviceType        String?
  presentation       String?                           @db.LongText
  ICMS               String?
  type               String
  companyName        String
  tradingName        String
  userId             Int                               @unique
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  visualizations     Int                               @default(0)
  architectComission Float?                            @default(0)
  dexdComission      Float?
  businessHours      Json?                             @db.Json
  dexdBoosts         DexdBoost[]
  serviceProviders   EnvironmentServiceProviderStore[]
  products           Product[]                         @relation("store")
  supplierProducts   Product[]                         @relation("supplier")
  shipping_labels    shipping_labels[]
  medias             StoreMedia[]
  promotions         StorePromotion[]
  user               User                              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stores")
}

model StoreMedia {
  id      Int    @id @default(autoincrement())
  url     String @db.LongText
  storeId Int
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId], map: "store_medias_storeId_fkey")
  @@map("store_medias")
}

model StorePromotion {
  id          Int       @id @default(autoincrement())
  storeId     Int
  title       String
  description String?   @db.LongText
  bannerUrl   String?   @db.LongText
  discount    String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId], map: "store_promotions_storeId_fkey")
  @@index([isActive], map: "store_promotions_isActive_idx")
  @@map("store_promotions")
}

model EnvironmentServiceProviderStore {
  storeId       Int
  environmentId Int
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, environmentId])
  @@index([storeId, environmentId])
  @@index([environmentId], map: "environments_service_providers_store_environmentId_fkey")
  @@map("environments_service_providers_store")
}

model ProductLikes {
  like      Boolean @default(true)
  userId    Int
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction)
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@id([userId, productId])
  @@index([userId, productId])
  @@index([productId], map: "products_likes_productId_fkey")
  @@map("products_likes")
}

model Product {
  id                         Int                          @id @default(autoincrement())
  name                       String
  price                      Float
  storeId                    Int?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  deletedAt                  DateTime?
  benefits                   String?                      @db.LongText
  description                String                       @db.LongText
  material                   String?                      @db.LongText
  moreDetails                String?                      @db.LongText
  cost                       Float
  measureHeight              Float
  measureLength              Float
  measureWidth               Float
  measurementUnitId          Int
  ncm                        String
  weight                     Float
  quantity                   Int                          @default(0)
  blocked                    Boolean                      @default(false)
  isCourse                   Boolean?                     @default(false)
  supplierId                 Int?
  dropShippingCommission     Int?
  cashback                   Float?                       @default(0)
  feedDescription            String?                      @db.VarChar(250)
  toFeed                     Boolean                      @default(true)
  capacity                   String?
  consumption                String?
  guarantee                  String?
  line                       String?
  measureHeightWithPackaging Float?
  measureLengthWithPackaging Float?
  measureWidthWithPackaging  Float?
  model                      String?
  power                      String?
  weightWithPackaging        Float?
  url                        String?                      @db.LongText
  type                       String?
  additionalData             Json?                        @db.Json
  dexdVideoId                Int?
  opportunities              BusinessOpportunityProduct[]
  complaints                 Complaint[]
  dexdBoosts                 DexdBoost[]
  dexdTvVideo                DexdTvVideo?
  tags                       Entity_Tag[]
  orderProducts              OrderProduct[]
  pins                       Pin[]
  carts                      ProductCart[]
  materials                  ProductMaterial[]
  medias                     Product_Media[]
  views                      ProductViews[]
  measurementUnit            Measurement_Unit             @relation(fields: [measurementUnitId], references: [id], onDelete: Cascade)
  store                      Store?                       @relation("store", fields: [storeId], references: [id], onDelete: Cascade, map: "products_store_ownerId_fkey")
  supplier                   Store?                       @relation("supplier", fields: [supplierId], references: [id], onDelete: Cascade, map: "products_supplierId_fkey")
  likes                      ProductLikes[]

  @@index([measurementUnitId], map: "products_measurementUnitId_fkey")
  @@index([storeId], map: "products_store_ownerId_fkey")
  @@index([supplierId], map: "products_supplierId_fkey")
  @@map("products")
}

model ProductViews {
  id        Int      @id @default(autoincrement())
  viewerId  Int?
  productId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product? @relation(fields: [productId], references: [id])
  viewer    User?    @relation(fields: [viewerId], references: [id])

  @@unique([viewerId, productId])
  @@index([productId], map: "product_views_productId_fkey")
  @@map("product_views")
}

model Product_Media {
  id        Int     @id @default(autoincrement())
  url       String  @db.LongText
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "product_medias_productId_fkey")
  @@map("product_medias")
}

model Product_Tribute {
  id             Int   @id @default(autoincrement())
  originStateId  Int
  destinyStateId Int
  tax            Float
  destinyState   State @relation("productTributeDestiny", fields: [destinyStateId], references: [id], onDelete: Cascade)
  originState    State @relation("productTributeOrigin", fields: [originStateId], references: [id], onDelete: Cascade)

  @@index([destinyStateId], map: "product_tribute_destinyStateId_fkey")
  @@index([originStateId], map: "product_tribute_originStateId_fkey")
  @@map("product_tributes")
}

model Measurement_Unit {
  id          Int       @id @default(autoincrement())
  code        String
  description String
  Product     Product[]

  @@map("measurement_units")
}

model ProductMaterial {
  id        Int      @id @default(autoincrement())
  material  String
  imageUrl  String   @db.LongText
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "product_materials_productId_fkey")
  @@map("product_materials")
}

model Address {
  id           Int                   @id @default(autoincrement())
  neighborhood String?
  street       String?
  number       String?
  zipcode      String
  city         String
  state        String
  uf           String
  country      String?
  street2      String?
  orderDestiny OrderDestinyAddress[]
  User         User[]

  @@map("adresses")
}

model State {
  id                    Int               @id @default(autoincrement())
  name                  String
  uf                    String?
  cities                City[]
  productTributeDestiny Product_Tribute[] @relation("productTributeDestiny")
  productTributeOrigin  Product_Tribute[] @relation("productTributeOrigin")

  @@map("states")
}

model City {
  id      Int    @id @default(autoincrement())
  name    String
  stateId Int
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId], map: "cities_stateId_fkey")
  @@map("cities")
}

model Language {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User[]

  @@map("languages")
}

model Tag {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  createdAt      DateTime        @default(now())
  categoryId     Int?
  subcategoryId  Int?
  subCategory    String?         // Mantido para compatibilidade
  entities       Entity_Tag[]
  category       TagCategory?    @relation(fields: [categoryId], references: [id])
  subcategory    TagSubcategory? @relation(fields: [subcategoryId], references: [id])

  @@index([categoryId], map: "tags_categoryId_fkey")
  @@index([subcategoryId], map: "tags_subcategoryId_fkey")
  @@map("tags")
}

model TagCategory {
  id               Int                 @id @default(autoincrement())
  name             String
  parentId         Int?                // Para criar hierarquia de categorias
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  icon             String?
  categoryEntities TagCategoryEntity[]
  tags             Tag[]
  subcategories    TagSubcategory[]
  parent           TagCategory?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children         TagCategory[]       @relation("CategoryHierarchy")

  @@index([parentId], map: "tag_categories_parentId_fkey")
  @@map("tag_categories")
}

model TagSubcategory {
  id         Int          @id @default(autoincrement())
  name       String
  categoryId Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tags       Tag[]
  category   TagCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([name, categoryId])
  @@index([categoryId], map: "tag_subcategories_categoryId_fkey")
  @@map("tag_subcategories")
}

model TagCategoryEntity {
  id               Int         @id @default(autoincrement())
  tagCategoryId    Int
  categoryEntityId Int
  categoryEntity   Role        @relation(fields: [categoryEntityId], references: [id], onDelete: Cascade)
  tagCategory      TagCategory @relation(fields: [tagCategoryId], references: [id], onDelete: Cascade)

  @@index([categoryEntityId], map: "tag_categories_entities_categoryEntityId_fkey")
  @@index([tagCategoryId], map: "tag_categories_entities_tagCategoryId_fkey")
  @@map("tag_categories_entities")
}

model Role {
  id                  Int                         @id @default(autoincrement())
  name                String                      @unique
  opportunitiesTarget BusinessOpportunityTarget[]
  permissions         Role_Permission[]
  categoryEntities    TagCategoryEntity[]
  user                User[]

  @@map("roles")
}

model Permission {
  id    Int               @id @default(autoincrement())
  name  String            @unique
  roles Role_Permission[]

  @@map("permissions")
}

model Entity_Tag {
  id             Int                  @id @default(autoincrement())
  visualizations Int                  @default(1)
  userId         Int?
  tagId          Int
  environmentId  Int?
  productId      Int?
  opportunityId  Int?
  type           String?
  dexdTvVideoId  Int?
  postId         Int?
  galleryId      Int?
  dexdTvVideo    DexdTvVideo?         @relation(fields: [dexdTvVideoId], references: [id], onDelete: Cascade)
  environment    Environment?         @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  opportunity    BusinessOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  post           Post?                @relation(fields: [postId], references: [id], onDelete: Cascade)
  product        Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  gallery        Gallery?             @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  tag            Tag                  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user           User?                @relation("UserTags", fields: [userId], references: [id])

  @@unique([userId, tagId, type], name: "user_tag")
  @@unique([productId, tagId], name: "product_tag")
  @@unique([environmentId, tagId], name: "environment_tag")
  @@unique([opportunityId, tagId], name: "opportunity_tag")
  @@unique([galleryId, tagId], name: "gallery_tag")
  @@index([dexdTvVideoId], map: "entities_tags_dexdTvVideoId_fkey")
  @@index([postId], map: "entities_tags_postId_fkey")
  @@index([galleryId], map: "entities_tags_galleryId_fkey")
  @@index([tagId], map: "entities_tags_tagId_fkey")
  @@map("entities_tags")
}

model JobExperienceSkill {
  id         Int       @id @default(autoincrement())
  company    String
  occupation String
  location   String
  startedAt  DateTime?
  finishedAt DateTime?
