  model_name            String?   @db.VarChar(100)
  max_tokens            Int?      @default(4000)
  temperature           Decimal?  @default(0.70) @db.Decimal(3, 2)
  timeout               Int?      @default(30000)
  rate_limit_per_minute Int?      @default(60)
  additional_config     Json?
  is_active             Boolean?  @default(true)
  is_primary            Boolean?  @default(false)
  created_at            DateTime? @default(now()) @db.Timestamp(0)
  updated_at            DateTime? @default(now()) @db.Timestamp(0)

  @@index([is_active], map: "idx_llm_credentials_active")
  @@index([provider], map: "idx_llm_credentials_provider")
}

model payment_methods {
  id                    Int                        @id @default(autoincrement())
  userId                Int
  methodType            payment_methods_methodType
  methodName            String                     @db.VarChar(255)
  isDefault             Boolean                    @default(false)
  isActive              Boolean                    @default(true)
  asaasToken            String?                    @db.VarChar(255)
  cardLastDigits        String?                    @db.VarChar(4)
  cardBrand             String?                    @db.VarChar(50)
  cardHolderName        String?                    @db.VarChar(255)
  expiryMonth           String?                    @db.VarChar(2)
  expiryYear            String?                    @db.VarChar(4)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @default(now())
  users                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_methods_user")
  subscription_settings subscription_settings[]

  @@index([isDefault], map: "idx_is_default")
  @@index([methodType], map: "idx_method_type")
  @@index([userId], map: "idx_user")
}

model shipping_label_errors {
  id               Int       @id @default(autoincrement())
  order_id         String    @db.VarChar(255)
  store_id         Int
  provider         String    @db.VarChar(100)
  service_code     String    @db.VarChar(50)
  error_message    String    @db.Text
  error_details    Json?
  resolved         Boolean?  @default(false)
  resolved_at      DateTime? @db.Timestamp(0)
  resolution_notes String?   @db.Text
  created_at       DateTime? @default(now()) @db.Timestamp(0)
}

model shipping_labels {
  id                  BigInt    @id @unique(map: "id") @default(autoincrement()) @db.UnsignedBigInt
  order_id            Int
  store_id            Int
  provider            String    @db.VarChar(50)
  service_name        String    @db.VarChar(50)
  service_code        String    @db.VarChar(10)
  tracking_code       String?   @db.VarChar(50)
  external_order_id   String?   @db.VarChar(50)
  freight_price       Decimal   @db.Decimal(10, 2)
  delivery_time       Int
  package_weight      Decimal   @db.Decimal(10, 2)
  package_height      Decimal   @db.Decimal(10, 2)
  package_width       Decimal   @db.Decimal(10, 2)
  package_length      Decimal   @db.Decimal(10, 2)
  declared_value      Decimal   @db.Decimal(10, 2)
  origin_zipcode      String    @db.VarChar(10)
  destination_zipcode String    @db.VarChar(10)
  label_url           String?   @db.VarChar(255)
  label_generated_at  DateTime? @db.Timestamp(0)
  label_data          String?   @db.Text
  status              String    @default("pending") @db.VarChar(50)
  created_at          DateTime  @default(now()) @db.Timestamp(0)
  updated_at          DateTime  @default(now()) @db.Timestamp(0)
  orders              Order     @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order")
  stores              Store     @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_store")

  @@index([order_id], map: "fk_order")
  @@index([store_id], map: "fk_store")
}

model subscription_history {
  id                                                                       Int                         @id @default(autoincrement())
  userId                                                                   Int
  subscriptionId                                                           Int
  userSubscriptionId                                                       Int
  action                                                                   subscription_history_action
  previousSubscriptionId                                                   Int?
  reason                                                                   String?                     @db.Text
  effectiveDate                                                            DateTime                    @db.DateTime(0)
  createdAt                                                                DateTime                    @default(now())
  subscriptions_subscription_history_previousSubscriptionIdTosubscriptions Subscription?               @relation("subscription_history_previousSubscriptionIdTosubscriptions", fields: [previousSubscriptionId], references: [id], onUpdate: NoAction, map: "fk_subscription_history_previous")
  subscriptions_subscription_history_subscriptionIdTosubscriptions         Subscription                @relation("subscription_history_subscriptionIdTosubscriptions", fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subscription_history_subscription")
  users                                                                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subscription_history_user")
  user_subscriptions                                                       UserSubscription            @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subscription_history_user_subscription")

  @@index([previousSubscriptionId], map: "fk_subscription_history_previous")
  @@index([effectiveDate], map: "idx_effective_date")
  @@index([subscriptionId], map: "idx_subscription")
  @@index([userId], map: "idx_user")
  @@index([userSubscriptionId], map: "idx_user_subscription")
}

model subscription_settings {
  id                  Int                                @id @default(autoincrement())
  userSubscriptionId  Int                                @unique(map: "uk_user_subscription_settings")
  autoRenew           Boolean                            @default(true)
  nextBillingDate     DateTime                           @db.DateTime(0)
  billingCycle        subscription_settings_billingCycle @default(MONTHLY)
  paymentMethodId     Int?
  notifyBeforeRenewal Boolean                            @default(true)
  notifyDaysBefore    Int                                @default(7)
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @default(now())
  payment_methods     payment_methods?                   @relation(fields: [paymentMethodId], references: [id], onUpdate: NoAction, map: "fk_subscription_settings_payment_method")
  user_subscriptions  UserSubscription                   @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subscription_settings_user_subscription")

  @@index([nextBillingDate], map: "idx_next_billing")
  @@index([paymentMethodId], map: "idx_payment_method")
}

model support_cases {
  case_id                  Int                     @id @default(autoincrement())
  order_id                 String                  @db.VarChar(50)
  client_id                Int
  provider_id              Int?
  case_type                support_cases_case_type
  issue_category           String                  @db.VarChar(50)
  issue_subcategory        String?                 @db.VarChar(50)
  status                   support_cases_status    @default(open)
  description              String?                 @db.Text
  created_at               DateTime?               @default(now()) @db.Timestamp(0)
  updated_at               DateTime?               @default(now()) @db.Timestamp(0)
  tracking_code            String?                 @db.VarChar(50)
  shipping_status          String?                 @db.VarChar(50)
  solution_proposed        String?                 @db.VarChar(100)
  rating_seller            Decimal?                @db.Decimal(2, 1)
  rating_communication     Decimal?                @db.Decimal(2, 1)
  rating_accuracy          Decimal?                @db.Decimal(2, 1)
  rating_delivery_time     Decimal?                @db.Decimal(2, 1)
  rating_package_condition Decimal?                @db.Decimal(2, 1)
  rating_courier_service   Decimal?                @db.Decimal(2, 1)
  payment_info             Json?
  product_info             Json?
  shipping_info            Json?
  return_reason            String?                 @db.VarChar(100)
  refund_amount            Decimal?                @db.Decimal(10, 2)
  refund_type              String?                 @db.VarChar(50)
  attachments_json         Json?
  additional_info          String?                 @db.Text
  admin_notes              String?                 @db.Text

  @@index([case_type], map: "idx_case_type")
  @@index([client_id], map: "idx_client_id")
  @@index([created_at], map: "idx_created_at")
  @@index([order_id], map: "idx_order_id")
  @@index([provider_id], map: "idx_provider_id")
  @@index([status], map: "idx_status")
}

model support_media {
  media_id    Int                      @id @default(autoincrement())
  case_id     Int
  media_type  support_media_media_type
  file_name   String                   @db.VarChar(255)
  file_url    String                   @db.VarChar(2048)
  file_size   Int?
  mime_type   String?                  @db.VarChar(100)
  upload_date DateTime?                @default(now()) @db.Timestamp(0)
  description String?                  @db.VarChar(255)
  is_active   Boolean?                 @default(true)

  @@index([case_id], map: "idx_case_id")
  @@index([media_type], map: "idx_media_type")
}

model testeInvest {
  id        Int       @id @default(autoincrement())
  entitieId Int?
  value     Float?
  createdAt DateTime? @db.DateTime(0)
}

model usage_tracking {
  id                 Int              @id @default(autoincrement())
  userId             Int
  userSubscriptionId Int
  featureKey         String           @db.VarChar(100)
  usageCount         Int              @default(1)
  usageDate          DateTime         @db.Date
  resourceId         Int?
  resourceType       String?          @db.VarChar(50)
  description        String?          @db.Text
  createdAt          DateTime         @default(now())
  users              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usage_tracking_user")
  user_subscriptions UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usage_tracking_user_subscription")

  @@index([featureKey], map: "idx_feature")
  @@index([resourceId, resourceType], map: "idx_resource")
  @@index([usageDate], map: "idx_usage_date")
  @@index([featureKey, usageDate], map: "idx_usage_tracking_feature_date")
  @@index([userId, usageDate], map: "idx_usage_tracking_user_date")
  @@index([userId], map: "idx_user")
  @@index([userSubscriptionId], map: "idx_user_subscription")
}

