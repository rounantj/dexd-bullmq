# Redis Configuration
# Opção 1: Use REDIS_URL (recomendado, mais simples)
REDIS_URL=redis://localhost:6379

# Opção 2: Ou use REDIS_HOST e REDIS_PORT separadamente
# REDIS_HOST=localhost
# REDIS_PORT=6379

# DEXD API Configuration
DEXD_API_URL=https://sua-api.com

# Extractor API (Python service for SEO extraction)
EXTRACTOR_API_URL=http://127.0.0.1:4000


