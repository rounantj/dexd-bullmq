{
    "name": "dexd-infra-workers",
    "version": "2.0.0",
    "description": "Dexd Background Workers - BullMQ + Redis para processamento de vídeos e produtos",
    "main": "dist/index.js",
    "scripts": {
        "build": "npx prisma generate && tsc",
        "postinstall": "npx prisma generate",
        "start": "node dist/server.js",
        "start:workers": "node dist/workers/productProcessingWorkerV2.js",
        "dev": "nodemon --exec ts-node src/server.ts",
        "dev:worker": "nodemon --exec ts-node src/worker.ts",
        "dev:product-worker": "nodemon --exec ts-node src/workers/productProcessingWorkerV2.ts",
        "dev:producer": "nodemon --exec ts-node src/producer.ts",
        "producer": "ts-node src/producer.ts",
        "worker": "ts-node src/worker.ts",
        "worker:product": "ts-node src/workers/productProcessingWorkerV2.ts"
    },
    "keywords": [
        "bullmq",
        "redis",
        "queue",
        "typescript",
        "workers",
        "dexd"
    ],
    "author": "Dexd Team",
    "license": "ISC",
    "dependencies": {
        "@bull-board/api": "^5.10.0",
        "@bull-board/express": "^5.10.0",
        "@prisma/client": "^5.7.0",
        "axios": "^1.6.2",
        "bullmq": "^5.0.0",
        "cheerio": "^1.0.0-rc.12",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "https-proxy-agent": "^7.0.2",
        "ioredis": "^5.3.2",
        "openai": "^4.20.0",
        "puppeteer": "^21.6.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.0",
        "nodemon": "^3.0.2",
        "prisma": "^5.7.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
